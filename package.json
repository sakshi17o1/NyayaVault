{
  "name": "nyayavault",
  "version": "0.1.0",
  "private": true,
  "description": "NyayaVault —  secure digital document management prototype",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "cron": "tsx scripts/cron-runner.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1138.0",
    "@aws-sdk/client-s3": "^3.1138.0",
    "@huggingface/transformers": "4.3.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.2",
    "clamscan": "^2.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "jose": "6.1.0",
    "lucide-react": "0.544.0",
    "next": "^16.3.6",
    "node-cron": "^4.6.0",
    "otplib": "13.5.0",
    "pdf-lib": "1.17.1",
    "pdf-parse": "2.4.5",
    "qrcode.react": "^4.2.0",
    "react": "19.1.1",
    "react-datepicker": "^9.1.0",
    "react-dom": "19.1.1",
    "tailwind-merge": "3.3.1",
    "tesseract.js": "7.0.0",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "24.5.2",
    "@types/react": "19.1.13",
    "@types/react-datepicker": "^6.2.0",
    "@types/react-dom": "19.1.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "prisma": "^6.19.3",
    "tailwindcss": "4.1.13",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "5.0.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  }
}
