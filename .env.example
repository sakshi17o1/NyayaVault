# NyayaVault local demo — copy to .env and never commit .env
# SQLite file is created under ./prisma (see DATABASE_URL).

DATABASE_URL="file:./dev.db"

# Min 32 characters. Used to sign session cookies.
SESSION_SECRET="replace-with-a-long-random-demo-secret-32chars"

# AES-256-GCM key material for the storage adapter (32-byte hex = 64 hex chars).
# PRODUCTION PATH: Use a real Key Management System (KMS) for envelope encryption. 
# Do not hardcode this key outside of demo mode. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# AWS KMS Configuration (used if AWS_KMS_KEY_ID is provided)
# AWS_KMS_KEY_ID="arn:aws:kms:us-east-1:123456789012:key/..."
# AWS_ACCESS_KEY_ID="..."
# AWS_SECRET_ACCESS_KEY="..."
# AWS_REGION="us-east-1"

# Required for Vercel Cron Jobs
# CRON_SECRET="generate-a-secure-random-string-here"

# Demo MFA challenge. Not a production authenticator.
DEMO_OTP="000000"

# Allow the presentation role switcher (still audited). Set false to require login each time.
DEMO_ROLE_SWITCH="true"

# Placeholder rate-limit (requests per minute per IP)
RATE_LIMIT_RPM="600"

# Object storage adapter: filesystem | s3
STORAGE_ADAPTER="filesystem"
STORAGE_ROOT="./storage/objects"

# S3 Configuration
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="nyayavault"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadminpassword"

# Search adapter: Prisma "contains" (OpenSearch not wired in MVP)
SEARCH_ADAPTER="prisma_contains"

# Ledger adapter: hash_chain (real MVP) | fabric_mock
LEDGER_ADAPTER="hash_chain"